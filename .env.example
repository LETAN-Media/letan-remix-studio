# PostgreSQL (required at runtime)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/letan_remix
# Direct, non-pooled connection used only by migrations. Falls back to DATABASE_URL locally.
DIRECT_URL=

# Better Auth (required in production; generate at least 32 random bytes)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (required only for asset upload/download operations)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=letan-remix-assets
# Publishing-only base URL. Private draft assets are served with short-lived signed GET URLs.
R2_PUBLIC_BASE_URL=

# Future Phase 2 provider contract. Never expose these as NEXT_PUBLIC_*.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional persistent rate-limit tuning
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SECONDS=60
